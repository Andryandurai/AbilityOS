# Copy this file to backend/.env and fill in values as needed.
# Every variable below has a safe default if omitted — AbilityOS is designed
# to run out of the box with no .env file at all (SQLite + AI fallback).

# --- Django core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-string-for-any-shared-deployment
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ------------------------------------------------------------------
# AbilityOS is designed for PostgreSQL (see docs/DATABASE.md). Leave unset to
# fall back to a local SQLite file (backend/db.sqlite3) — the recommended
# path for a quick hackathon setup with no Postgres server installed.
# DATABASE_URL=postgres://abilityos:abilityos@localhost:5432/abilityos

# --- CORS (frontend origin) ----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3434,http://127.0.0.1:3434
CORS_ALLOW_ALL_ORIGINS=false

# --- AI Decision Engine (Part 7 / Part 9) --------------------------------------
# Leave AI_PROVIDER=none (or unset) to run entirely on the deterministic
# Adaptation Engine fallback — this is a fully legitimate, tested decision
# path, not a degraded mode. Set a provider + key to enable live LLM
# reasoning on top of it.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Computer vision / OCR environment analysis (P1, optional) ----------------
# Requires opencv-python-headless (see requirements.txt). The JSON-fixture
# environment path works with this left false.
VISION_ENABLED=false
